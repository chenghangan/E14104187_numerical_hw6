import numpy as np

def gaussian_elimination_with_pivoting(A, b):
    n = len(b)
    
    # Combine A and b into augmented matrix
    Ab = np.hstack([A, b.reshape(-1, 1)])
    
    for i in range(n):
        # Partial pivoting
        max_row = np.argmax(np.abs(Ab[i:, i])) + i
        Ab[[i, max_row]] = Ab[[max_row, i]]
        
        # Elimination
        for j in range(i + 1, n):
            factor = Ab[j, i] / Ab[i, i]
            Ab[j, i:] -= factor * Ab[i, i:]
    
    # Back substitution
    x = np.zeros(n)
    for i in range(n-1, -1, -1):
        x[i] = (Ab[i, -1] - np.dot(Ab[i, i+1:n], x[i+1:n])) / Ab[i, i]
    
    return x

# Define the system
A = np.array([
    [1.19, 2.11, -100, 1],
    [14.2, -0.112, 12.2, -3.44],
    [0, 100, -99.9, 2.15],
    [15.3, 0.110, -13.1, -4.16]
], dtype=float)

b = np.array([1.12, -1, 0, 1], dtype=float)

# Solve the system
solution = gaussian_elimination_with_pivoting(A, b)
print("Solution:")
print(f"x₁ = {solution[0]:.6f}")
print(f"x₂ = {solution[1]:.6f}")
print(f"x₃ = {solution[2]:.6f}")
print(f"x₄ = {solution[3]:.6f}")
